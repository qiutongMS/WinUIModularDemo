<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: simplest to build and run from the CLI. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ExperimentalApisAvailable Condition="$([System.String]::Copy('$(WindowsAppSDKVersion)').Contains('-exp'))">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(BuildExperimentalExtensions)' == 'true'">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(ExperimentalApisAvailable)' == ''">false</ExperimentalApisAvailable>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Extension>
      <RequiresExperimentalApis>false</RequiresExperimentalApis>
    </Extension>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Extension Include="HelloPage">
      <RequiresExperimentalApis>true</RequiresExperimentalApis>
      <ProjectPath>..\Extensions\HelloPage\Ext.HelloPage.csproj</ProjectPath>
      <CompositionSource>..\Extensions\HelloPage\ShellExtension.cs</CompositionSource>
      <CompositionLink>Extensions\HelloPage\ShellExtension.cs</CompositionLink>
    </Extension>
    <Extension Include="HelloUserControl">
      <RequiresExperimentalApis>true</RequiresExperimentalApis>
      <ProjectPath>..\Extensions\HelloUserControl\Ext.HelloUserControl.csproj</ProjectPath>
      <CompositionSource>..\Extensions\HelloUserControl\ShellExtension.cs</CompositionSource>
      <CompositionLink>Extensions\HelloUserControl\ShellExtension.cs</CompositionLink>
    </Extension>
  </ItemGroup>

  <ItemGroup>
    <ExtensionRequiringExperimentalApis Include="@(Extension->WithMetadataValue('RequiresExperimentalApis', 'true'))" />
    <SelectedExtension Include="@(Extension->WithMetadataValue('RequiresExperimentalApis', 'false'))" />
    <SelectedExtension Include="@(ExtensionRequiringExperimentalApis)"
                       Condition="'$(ExperimentalApisAvailable)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="@(SelectedExtension -> '%(CompositionSource)')"
             Link="%(CompositionLink)" />
    <ProjectReference Include="@(SelectedExtension -> '%(ProjectPath)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <Target Name="RemoveStaleExtensionOutputs"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(ExperimentalApisAvailable)' != 'true'">
    <ItemGroup>
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)Ext.%(Identity).dll')" />
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)Ext.%(Identity).pdb')" />
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)Ext.%(Identity).pri')" />
      <StaleExtensionDirectory Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)Ext.%(Identity)')" />
    </ItemGroup>

    <Delete Files="@(StaleExtensionFile)" />
    <RemoveDir Directories="@(StaleExtensionDirectory)" />
  </Target>

</Project>
