<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: simplest to build and run from the CLI. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ExperimentalApisAvailable Condition="$([System.String]::Copy('$(WindowsAppSDKVersion)').Contains('-exp'))">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(BuildExperimentalExtensions)' == 'true'">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(ExperimentalApisAvailable)' == ''">false</ExperimentalApisAvailable>
  </PropertyGroup>

  <ItemGroup>
    <ExperimentalExtension Include="HelloPage" />
    <ExperimentalExtension Include="HelloUserControl" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExperimentalApisAvailable)' == 'true'">
    <Compile Include="..\Extensions\HelloPage\ShellExtension.cs"
             Link="Extensions\HelloPage\ShellExtension.cs" />
    <Compile Include="..\Extensions\HelloUserControl\ShellExtension.cs"
             Link="Extensions\HelloUserControl\ShellExtension.cs" />
    <ProjectReference Include="..\Extensions\HelloPage\Ext.HelloPage.csproj" />
    <ProjectReference Include="..\Extensions\HelloUserControl\Ext.HelloUserControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <Target Name="RemoveStaleExtensionOutputs"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(ExperimentalApisAvailable)' != 'true'">
    <ItemGroup>
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).dll')" />
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).pdb')" />
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).pri')" />
      <StaleExtensionDirectory Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity)')" />
    </ItemGroup>

    <Delete Files="@(StaleExtensionFile)" />
    <RemoveDir Directories="@(StaleExtensionDirectory)" />
  </Target>

</Project>
