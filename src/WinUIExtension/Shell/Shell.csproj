<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Extensions.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: simplest to build and run from the CLI. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(StableExtension -> '..\Extensions\%(Identity)\Ext.%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExperimentalApisAvailable)' == 'true'">
    <ProjectReference Include="@(ExperimentalExtension -> '..\Extensions\%(Identity)\Ext.%(Identity).csproj')" />
  </ItemGroup>

  <Target Name="RemoveStaleExtensionOutputs"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(ExperimentalApisAvailable)' != 'true'">
    <ItemGroup>
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).dll')" />
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).pdb')" />
      <StaleExtensionFile Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity).pri')" />
      <StaleExtensionDirectory Include="@(ExperimentalExtension -> '$(TargetDir)Ext.%(Identity)')" />
    </ItemGroup>

    <Delete Files="@(StaleExtensionFile)" />
    <RemoveDir Directories="@(StaleExtensionDirectory)" />
  </Target>

</Project>
