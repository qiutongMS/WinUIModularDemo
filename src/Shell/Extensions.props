<Project>
  <!--
    Single source of truth for which extensions the Shell references and runtime-discovers.
    Promote a feature by moving its entry from <ExperimentalExtension> to <StableExtension>:
    no file moves, no code changes beyond adjusting the extension .csproj (see its comments).

    Each Identity must match the folder name under src\Extensions\ and the suffix on the
    extension csproj/assembly name (Ext.<Identity>).
  -->
  <ItemGroup>
    <!-- Stable extensions: built and loaded in both flavors. (none yet) -->

    <!-- Experimental extensions: built and loaded only when IncludeExperimentalApis=true. -->
    <ExperimentalExtension Include="HelloUserControl" />
    <ExperimentalExtension Include="HelloPage" />
  </ItemGroup>
</Project>
