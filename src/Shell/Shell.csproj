<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Per-feature extensibility model (mirrors the WindowsAIFoundry sample):
      Optional features live as independent class libraries under src\Extensions\<Feature>\.
      Which features exist and their maturity (stable vs experimental) is declared in
      Extensions.props. The Shell references Contracts plus whichever extensions match the
      current build flavor, then discovers [NavItem]-decorated entry types at startup via
      reflection - so it has zero per-feature code.
  -->
  <Import Project="Extensions.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: simplest to build and run from the CLI. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- The Shell always references the SDK-neutral contract assembly (the [NavItem] attribute). -->
  <ItemGroup>
    <ProjectReference Include="..\Contracts\WinUIModularDemo.Contracts.csproj" />
  </ItemGroup>

  <!-- Stable extensions: always referenced. -->
  <ItemGroup>
    <ProjectReference Include="@(StableExtension -> '..\Extensions\%(Identity)\Ext.%(Identity).csproj')" />
  </ItemGroup>

  <!-- A Windows App SDK prerelease beginning with "-e" automatically adds experimental
       extensions to the build graph. Stable SDK versions never evaluate these projects. -->
  <ItemGroup Condition="'$(IsExperimentalWindowsAppSDK)' == 'true'">
    <ProjectReference Include="@(ExperimentalExtension -> '..\Extensions\%(Identity)\Ext.%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

</Project>
