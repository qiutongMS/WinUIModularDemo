<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Experimental.HelloUserControl.HelloView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <TextBlock Text="Hello from a UserControl feature (XAML)"
                   Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="I am a UserControl defined in XAML. The Shell hosted me by setting ContentControl.Content = new HelloView(). No Page, no Frame." />
        <Button Content="Click me" Click="OnClick" />
        <TextBlock x:Name="Status" Foreground="{ThemeResource SystemAccentColor}" />
    </StackPanel>
</UserControl>
