<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ext.HelloPage</RootNamespace>
    <AssemblyName>Ext.HelloPage</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      The empty-DLL technique.

      This repo is designed to be built as a SOLUTION (see build.cmd / CI), and a solution build
      compiles EVERY project it lists - a build-time property cannot drop a project from that set.
      So in the stable flavor this experimental extension must still "build", but with no content:
      EnableDefaultItems=false compiles no source, producing an empty assembly. The solution build
      succeeds and the Shell (which only references experimental extensions when the flag is on)
      never loads that empty DLL.

      When this extension graduates to stable: delete the two lines below, set UseWinUI to true
      unconditionally, remove the Condition on the ItemGroup, and move it from ExperimentalExtension
      to StableExtension in src\Shell\Extensions.props.
    -->
    <EnableDefaultItems Condition="'$(IncludeExperimentalApis)' != 'true'">false</EnableDefaultItems>
    <UseWinUI Condition="'$(IncludeExperimentalApis)' == 'true'">true</UseWinUI>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeExperimentalApis)' == 'true'">
    <ProjectReference Include="..\..\Contracts\WinUIModularDemo.Contracts.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

</Project>
