<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ext.HelloPage.DemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <TextBlock Text="Hello from a Page feature (XAML)"
                   Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="I am a Page defined in XAML. The Shell hosted me via Frame.Navigate(typeof(DemoPage)). Because a Frame drives me, I get navigation lifecycle callbacks." />
        <TextBlock x:Name="Status" Foreground="{ThemeResource SystemAccentColor}" />
    </StackPanel>
</Page>
