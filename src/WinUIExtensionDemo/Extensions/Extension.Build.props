<Project>
  <!--
    Shared extension build behavior. Extensions that require experimental APIs stay
    visible in the solution for editing, but compile as empty placeholder assemblies
    when those APIs are not available.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\Shell\Extensions.props" />

  <PropertyGroup>
    <ExtensionIdentity Condition="'$(ExtensionIdentity)' == '' and $([System.String]::Copy('$(AssemblyName)').StartsWith('Ext.'))">$([System.String]::Copy('$(AssemblyName)').Substring(4))</ExtensionIdentity>
  </PropertyGroup>

  <Target Name="RemovePlaceholderExtensionItems"
          BeforeTargets="PrepareForBuild;MarkupCompilePass1;MarkupCompilePass2;CoreCompile"
          Condition="$([System.String]::Copy(';$(ExtensionsRequiringExperimentalApis);').Contains(';$(ExtensionIdentity);')) and '$(ExperimentalApisAvailable)' != 'true'">
    <ItemGroup>
      <Compile Remove="**\*.cs" />
      <Page Remove="**\*.xaml" />
      <Content Remove="**\*" />
      <None Remove="**\*" />
      <EmbeddedResource Remove="**\*.resw" />
      <PRIResource Remove="**\*.resw" />
      <Resource Remove="**\*.resw" />
    </ItemGroup>
  </Target>
</Project>
