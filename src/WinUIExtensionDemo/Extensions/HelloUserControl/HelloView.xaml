<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ext.HelloUserControl.HelloView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <TextBlock Text="Hello from a UserControl feature (XAML)"
                   Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="I am a UserControl defined in XAML. The Shell hosted me by setting ContentControl.Content = new HelloView(). No Page, no Frame." />
        <!-- ExtensionResourceText.Text is supplied by this project's Resources.resw. -->
        <TextBlock
            x:Uid="ExtensionResourceText"
            AutomationProperties.AutomationId="HelloView_ResourceText"
            Style="{StaticResource CaptionTextBlockStyle}" />
        <Image
            Width="64"
            Height="64"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Extension-owned asset"
            Source="Assets/ExtensionAsset.svg" />
        <Button
            AutomationProperties.AutomationId="HelloView_ClickButton"
            Content="Click me"
            Click="OnClick" />
        <TextBlock x:Name="Status" />
    </StackPanel>
</UserControl>
