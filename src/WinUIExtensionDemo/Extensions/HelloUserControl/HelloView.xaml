<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ext.HelloUserControl.HelloView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ExtensionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <TextBlock Text="Hello from a UserControl feature (XAML)"
                   Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="I am a UserControl defined in XAML. The Shell hosted me by setting ContentControl.Content = new HelloView(). No Page, no Frame." />
        <Button
            AutomationProperties.AutomationId="HelloView_ClickButton"
            Content="Click me"
            Click="OnClick" />
        <TextBlock x:Name="Status"
                   Text="This style comes from the extension resource dictionary."
                   Style="{StaticResource ExtensionStatusTextStyle}" />
    </StackPanel>
</UserControl>
