<Project>
  <!--
    Single source of truth for which extensions the Shell references and runtime-discovers.
    Extensions are optional modules, not a synonym for experimental API usage.

    Add only the extensions that currently require experimental APIs to
    ExtensionsRequiringExperimentalApis. When those APIs become stable, remove
    that entry and the extension becomes a regular always-built extension without
    moving files or changing Shell code.

    Each Identity must match the folder name under Extensions\ and the suffix on the
    extension csproj/assembly name (Ext.<Identity>).
  -->
  <PropertyGroup>
    <ExperimentalApisAvailable Condition="$([System.String]::Copy('$(WindowsAppSDKVersion)').Contains('-exp'))">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(BuildExperimentalExtensions)' == 'true'">true</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="'$(ExperimentalApisAvailable)' == ''">false</ExperimentalApisAvailable>
    <ExtensionsRequiringExperimentalApis>HelloUserControl;HelloPage</ExtensionsRequiringExperimentalApis>
  </PropertyGroup>

  <ItemGroup>
    <Extension Include="HelloUserControl" />
    <Extension Include="HelloPage" />
  </ItemGroup>
</Project>
