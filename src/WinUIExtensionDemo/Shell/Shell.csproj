<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Per-feature extensibility model (mirrors the WindowsAIFoundry sample):
      Optional features live as independent class libraries under Extensions\<Feature>\.
      Extensions.props declares the features and whether any of them currently require
      experimental APIs. The Shell always references the extension projects, then discovers
      their public Page/UserControl types at startup via reflection. An extension that
      requires experimental APIs can build as an empty placeholder when those APIs are not
      available, so the solution still exposes all extension code.
  -->
  <Import Project="Extensions.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: simplest to build and run from the CLI. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Extensions are always solution-visible; each extension decides whether it contributes UI for this build. -->
  <ItemGroup>
    <ProjectReference Include="@(Extension -> '..\Extensions\%(Identity)\Ext.%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

</Project>
